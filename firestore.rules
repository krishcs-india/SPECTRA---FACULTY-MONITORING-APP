rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Institutional Application-Level Authorization
    // Users authenticate directly via registered institutional email in the app.
    // All collection reads and writes are managed by the application layer.

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Departments Collection
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // Periods Collection (Dynamic Timetable Slots)
    match /periods/{periodId} {
      allow read, write: if true;
    }

    // Subjects Collection (Department-scoped)
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Schedules Collection (Dynamic daily records)
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Global System Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Fallback catch-all for any nested documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
