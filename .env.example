# ==============================================================================
# KALYANI Faculty Availability & Period Management System
# Production Environment Configuration
# ==============================================================================

# Firebase / Google Cloud Project Credentials
# (Obtain these from your Firebase Console -> Project Settings -> General -> Your Apps -> Web App)
VITE_FIREBASE_API_KEY=AIzaSy...Your_Real_API_Key_Here
VITE_FIREBASE_AUTH_DOMAIN=kalyani-academic-system.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kalyani-academic-system
VITE_FIREBASE_STORAGE_BUCKET=kalyani-academic-system.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Google Workspace Authorized Domain Restriction
# e.g. "kalyani.college.edu.in" or leave blank for any authorized email listed in Kalyani User Directory
VITE_AUTH_ALLOWED_DOMAIN=
